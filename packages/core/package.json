{
  "name": "@triplex-build/triplex",
  "version": "0.1.0",
  "description": "An Effect-native fact database with Datalog and typed, content-addressed configuration.",
  "keywords": [
    "configuration",
    "content-addressed",
    "database",
    "datalog",
    "effect",
    "sha-256",
    "triplestore"
  ],
  "homepage": "https://github.com/bjacobso/triplex#readme",
  "bugs": {
    "url": "https://github.com/bjacobso/triplex/issues"
  },
  "license": "MIT",
  "author": "Ben Jacobson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/triplex.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./content": "./src/content/index.ts",
    "./datalog": "./src/datalog/index.ts",
    "./derivation": "./src/derivation/index.ts",
    "./internal": "./src/internal.ts",
    "./operational": "./src/operational/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./subscriptions": "./src/subscriptions/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/runtime/tsconfig.json",
    "clean": "rm -rf dist",
    "bench:config": "node bench/config/scale.mjs",
    "bench:config:typecheck": "node bench/config/typecheck-budget.mjs"
  },
  "dependencies": {
    "ulidx": "2.4.1"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22"
  }
}
