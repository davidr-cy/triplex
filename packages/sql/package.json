{
  "name": "@triplex-build/triplex-sql",
  "version": "0.1.0",
  "description": "Shared SQL layers and query execution for Triplex",
  "keywords": [
    "database",
    "effect",
    "sql",
    "triplestore"
  ],
  "homepage": "https://github.com/bjacobso/triplex#readme",
  "bugs": {
    "url": "https://github.com/bjacobso/triplex/issues"
  },
  "license": "MIT",
  "author": "Ben Jacobson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/triplex.git",
    "directory": "packages/sql"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --rootDir src --outDir dist",
    "dev": "tsdown --watch",
    "test": "vitest --run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@triplex-build/triplex": "workspace:^"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22"
  }
}
